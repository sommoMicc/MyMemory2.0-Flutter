# Client identifiers are public. Private keys remain outside the repository.
# Empty values leave the corresponding login unavailable.
AUTH_PUBLIC_ORIGIN=https://sommomemory.sommomi.cc
AUTH_GOOGLE_WEB_CLIENT_ID=
AUTH_GOOGLE_IOS_CLIENT_ID=
AUTH_GOOGLE_ANDROID_CLIENT_ID=
# Optional additional accepted audiences, comma separated.
AUTH_GOOGLE_CLIENT_IDS=
AUTH_APPLE_APP_ID=cc.sommomi.mymemory
AUTH_APPLE_SERVICE_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY_FILE=/run/secrets/mymemory-apple-signin.p8
AUTH_APPLE_REDIRECT_URI=https://sommomemory.sommomi.cc/api/v1/auth/callback/apple
